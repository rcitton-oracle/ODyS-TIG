# -----------------------------------------------------------------
#
#    NAME
#      Dynamicscaling Telegraf InfluxDB Grafana (ODyS-TIG)
#
#    DESCRIPTION
#      ODyS-TIG configuration file
#
#    AUTHOR:
#      ruggero.citton@oracle.com
#
#    NOTES
#      Copy this file and customize for your environment.
#      Do NOT commit sensitive credentials to version control.
#
#    MODIFIED   (MM/DD/YY)
#    rcitton     01/26/26 - Refactored with better documentation
#    rcitton     03/16/23 - creation
#
# -----------------------------------------------------------------

# =================================================================
# PLATFORM CONFIGURATION
# =================================================================

# Operating system type: 'Linux' or 'MacOS'
OS_TYPE=Linux

# macOS only: Absolute path to project directory on the host
# Example: /Users/johndoe/Projects/ODyS-TIG
# This is required because Docker Desktop uses a VM
MACOS_HOST_PROJECT_PATH=

# =================================================================
# CONTAINER ENGINE CONFIGURATION
# =================================================================

# Path to container engine binary
# Options: /usr/bin/podman, /usr/bin/docker, /usr/local/bin/docker
CONTAINER_ENGINE=/usr/bin/podman

# Path to container compose binary
# Options: /usr/bin/podman-compose, /usr/bin/docker-compose, docker compose
CONTAINER_COMPOSE=/usr/bin/podman-compose

# HTTP/HTTPS proxy (optional)
# Example: http://proxy.company.com:8080
PROXY=

# =================================================================
# TIMEZONE CONFIGURATION
# =================================================================

# Timezone for Telegraf container
# See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=Europe/Rome

# =================================================================
# INFLUXDB CONFIGURATION (InfluxDB 2.x)
# =================================================================

# Admin username for InfluxDB
INFLUXDB_INIT_USERNAME=admin

# Admin password (MUST be >= 8 characters)
# WARNING: Change this for production deployments!
INFLUXDB_INIT_PASSWORD=adminadmin123

# API token for authentication
# WARNING: Change this for production deployments!
INFLUXDB_INIT_ADMIN_TOKEN=my-super-secret-auth-token

# Organization name
INFLUXDB_INIT_ORG=myorg

# =================================================================
# GRAFANA CONFIGURATION
# =================================================================

# Admin username for Grafana
GF_SECURITY_ADMIN_USER=admin

# Admin password
# WARNING: Change this for production deployments!
GF_SECURITY_ADMIN_PASSWORD=admin

# =================================================================
# USER/GROUP CONFIGURATION
# =================================================================

# UID/GID for container processes (affects volume permissions)
# Uncomment and set if you need specific user/group IDs
# UID=1000
# GID=1000

# -----------------------------------------------------------------
# EndOfFile
# -----------------------------------------------------------------
